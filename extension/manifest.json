{
  "manifest_version": 3,
  "name": "Local AI Relay Sidecar",
  "version": "0.1.0",
  "description": "Manifest V3 browser extension sidecar for Local AI Relay.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local AI Relay Sidecar",
    "default_popup": "popup.html"
  }
}
