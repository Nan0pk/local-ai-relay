# Copy to .env and edit. This file is safe to commit; .env is not.

# Host the Fastify server binds to.
# Use 127.0.0.1 for local-only access. Use 0.0.0.0 to expose on all
# interfaces (not recommended; explicit acknowledgement and token required).
HOST=127.0.0.1

# Port the Fastify server listens on.
PORT=8787

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Default model used when a chat completion request omits `model`.
# Must match a model id returned by GET /v1/models.
DEFAULT_MODEL=relay-auto

# Shared persistent profile used when the existing-browser extension is not
# paired. Never point this at a profile currently open in Chrome. Default:
# ~/.local-ai-relay/browser-profiles/shared
# RELAY_BROWSER_PROFILE_SHARED=

# Optional provider-specific overrides. They take precedence over the shared
# fallback profile and are intended for deliberate isolation.
# RELAY_BROWSER_PROFILE=

# Optional Claude-only fallback profile.
# RELAY_BROWSER_PROFILE_CLAUDE=

# Optional Meta-AI-only fallback profile.
# RELAY_BROWSER_PROFILE_META=

# Optional managed browser binaries live under ./.relay-browser/browsers and
# are gitignored. If no system Chrome/Chromium is found, the first browser
# launch downloads managed Chromium and fails clearly if installation fails.
# PLAYWRIGHT_BROWSERS_PATH=
# Optional system Chromium/Chrome executable instead of automatic detection.
# Standard Chrome/Chromium locations are detected on Windows, macOS, and Linux.
# RELAY_BROWSER_EXECUTABLE=

# Browser requests are visible by default. Headless mode is experimental.
RELAY_BROWSER_HEADLESS=0
RELAY_BROWSER_TIMEOUT_MS=180000

# Bound sticky pages so abandoned harness sessions cannot grow forever.
RELAY_BROWSER_MAX_SESSIONS=8

# Startup never edits Hermes/OpenCode config unless this explicit opt-in is set.
# RELAY_AUTO_CONFIGURE_HARNESSES=1

# Comma-separated extension IDs allowed to call general HTTP API routes.
# Normal existing-browser pairing does not need this; its key is restricted to
# the browser bridge routes regardless of extension ID.
# RELAY_EXTENSION_IDS=

# A local screenshot is written on browser failures. It can contain prompt
# content; set this to 0 to disable it.
RELAY_DIAGNOSTICS=1
# RELAY_DIAGNOSTICS_DIR=

# Provider authentication is never configured here. Use the dashboard and sign
# in normally on the official page only when its live composer requires it.
# Never copy cookies, session tokens, or passwords into this file.
